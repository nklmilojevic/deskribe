{
  "plural": "persistentvolumes",
  "object": {
    "apiVersion": "v1",
    "kind": "PersistentVolume",
    "metadata": {
      "name": "demo",
      "uid": "demo-uid",
      "finalizers": [
        "kubernetes.io/pv-protection"
      ]
    },
    "spec": {
      "storageClassName": "fast",
      "claimRef": {
        "namespace": "default",
        "name": "claim"
      },
      "persistentVolumeReclaimPolicy": "Retain",
      "accessModes": [
        "ReadWriteOnce"
      ],
      "volumeMode": "Filesystem",
      "capacity": {
        "storage": "1Gi"
      },
      "nodeAffinity": {
        "required": {
          "nodeSelectorTerms": [
            {
              "matchExpressions": [
                {
                  "key": "topology.kubernetes.io/zone",
                  "operator": "In",
                  "values": [
                    "zone-a",
                    "zone-b"
                  ]
                },
                {
                  "key": "disk",
                  "operator": "Exists"
                }
              ]
            }
          ]
        }
      },
      "csi": {
        "driver": "csi.example.org",
        "volumeHandle": "disk-123",
        "readOnly": false,
        "fsType": "ext4",
        "volumeAttributes": {
          "replicas": "2",
          "zone": "zone-a"
        }
      }
    },
    "status": {
      "phase": "Bound",
      "message": ""
    }
  },
  "events": []
}
