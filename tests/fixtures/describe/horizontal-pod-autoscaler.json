          }
        },
        {
          "type": "ContainerResource",
          "containerResource": {
            "name": "memory",
            "container": "web",
            "target": {
              "type": "AverageValue",
              "averageValue": "128Mi"
            }
          }
        },
        {
          "type": "External",
          "external": {
            "metric": {
              "name": "queue_depth"
            },
            "target": {
              "type": "Value",
              "value": "100"
            }
          }
        },
        {
          "type": "External",
          "external": {
            "metric": {
              "name": "avg_queue"
            },
            "target": {
              "type": "AverageValue",
              "averageValue": "10"
            }
          }
        },
        {
          "type": "Pods",
          "pods": {
            "metric": {
              "name": "packets"
            },
            "target": {
              "type": "AverageValue",
              "averageValue": "1000"
            }
          }
        },
        {
          "type": "Object",
          "object": {
            "metric": {
              "name": "requests"
            },
