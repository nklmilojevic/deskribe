{
  "plural": "horizontalpodautoscalers",
  "object": {
    "apiVersion": "autoscaling/v2",
    "kind": "HorizontalPodAutoscaler",
    "metadata": {
      "name": "demo",
      "namespace": "default",
      "uid": "demo-uid",
      "creationTimestamp": "2026-01-01T00:00:00Z"
    },
    "spec": {
      "scaleTargetRef": {
        "apiVersion": "apps/v1",
