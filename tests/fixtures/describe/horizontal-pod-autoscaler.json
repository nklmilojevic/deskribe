              "name": "api",
              "apiVersion": "v1"
            },
            "target": {
              "type": "Value",
              "value": "100"
            }
          }
        }
      ],
      "behavior": {
        "scaleUp": {
          "stabilizationWindowSeconds": 60,
          "policies": [
            {
              "type": "Pods",
              "value": 4,
              "periodSeconds": 60
            },
            {
              "type": "Percent",
              "value": 100,
              "periodSeconds": 60
            }
          ]
        },
        "scaleDown": {
          "selectPolicy": "Min",
          "policies": [
            {
              "type": "Percent",
              "value": 10,
              "periodSeconds": 30
            }
          ]
        }
