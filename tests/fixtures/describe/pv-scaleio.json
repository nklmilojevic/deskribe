{
  "plural": "persistentvolumes",
  "object": {
    "apiVersion": "v1",
    "kind": "PersistentVolume",
    "metadata": {
      "name": "demo",
      "uid": "demo-uid",
      "finalizers": ["kubernetes.io/pv-protection"]
    },
    "spec": {
      "storageClassName": "fast",
      "claimRef": {
        "namespace": "default",
        "name": "claim"
      },
      "persistentVolumeReclaimPolicy": "Retain",
      "accessModes": ["ReadWriteOnce"],
      "volumeMode": "Filesystem",
      "capacity": {
        "storage": "1Gi"
      },
      "nodeAffinity": {
        "required": {
          "nodeSelectorTerms": [
            {
              "matchExpressions": [
                {
                  "key": "topology.kubernetes.io/zone",
                  "operator": "In",
                  "values": ["zone-a", "zone-b"]
                },
                {
                  "key": "disk",
                  "operator": "Exists"
                }
              ]
            }
          ]
        }
      },
      "scaleIO": {
        "gateway": "https://example.org",
        "system": "system",
        "protectionDomain": "domain",
        "storagePool": "pool",
        "storageMode": "ThinProvisioned",
        "volumeName": "disk",
        "secretRef": {
          "name": "credentials",
          "namespace": "default"
        },
        "fsType": "ext4",
        "readOnly": true
      }
    },
    "status": {
      "phase": "Bound",
      "message": ""
    }
  },
  "events": []
}
