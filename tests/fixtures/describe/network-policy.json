{
  "plural": "networkpolicies",
  "object": {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "NetworkPolicy",
    "metadata": {
      "name": "demo",
      "namespace": "default",
      "uid": "demo-uid",
      "creationTimestamp": "2026-01-01T00:00:00Z"
    },
    "spec": {
      "podSelector": { "matchLabels": { "app": "web" } },
      "policyTypes": ["Ingress", "Egress"],
      "ingress": [
        {
          "ports": [{ "protocol": "TCP", "port": 8000, "endPort": 8080 }],
          "from": [
            {
              "namespaceSelector": { "matchLabels": { "team": "blue" } },
              "podSelector": { "matchExpressions": [{ "key": "role", "operator": "Exists" }] }
            },
            { "ipBlock": { "cidr": "10.0.0.0/8", "except": ["10.1.0.0/16"] } }
          ]
        },
        {}
      ],
      "egress": [
        { "ports": [{ "protocol": "UDP", "port": 53 }], "to": [{ "namespaceSelector": {} }] }
      ]
    }
  },
  "events": []
}
