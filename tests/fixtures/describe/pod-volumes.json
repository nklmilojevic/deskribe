{
  "plural": "pods",
  "object": {
    "apiVersion": "v1",
    "kind": "Pod",
    "metadata": {
      "name": "demo",
      "namespace": "default",
      "uid": "demo-uid",
      "creationTimestamp": "2026-01-01T00:00:00Z"
    },
    "spec": {
      "containers": [
        {
          "name": "app",
          "image": "example.invalid/app"
        }
      ],
      "volumes": [
        {
          "name": "host",
          "hostPath": {
            "path": "/var/test",
            "type": "Directory"
          }
        },
        {
          "name": "secret",
          "secret": {
            "secretName": "synthetic",
            "optional": true
          }
        },
        {
          "name": "nfs",
          "nfs": {
            "server": "example.invalid",
            "path": "/share",
            "readOnly": true
          }
        },
        {
          "name": "claim",
          "persistentVolumeClaim": {
            "claimName": "data"
          }
        },
        {
          "name": "ephemeral",
          "ephemeral": {
            "volumeClaimTemplate": {
              "metadata": {
                "labels": {
                  "app": "test"
                }
              },
              "spec": {
                "storageClassName": "fast",
                "volumeMode": "Filesystem",
                "accessModes": ["ReadWriteOnce"],
                "resources": {
                  "requests": {
                    "storage": "1Gi"
                  }
                }
              }
            }
          }
        },
        {
          "name": "projected",
          "projected": {
            "sources": [
              {
                "secret": {
                  "name": "secret"
                }
              },
              {
                "downwardAPI": {}
              },
              {
                "configMap": {
                  "name": "settings",
                  "optional": true
                }
              },
              {
                "serviceAccountToken": {
                  "path": "token",
                  "expirationSeconds": 3600
                }
              }
            ]
          }
        },
        {
          "name": "downward",
          "downwardAPI": {
            "items": [
              {
                "path": "labels",
                "fieldRef": {
                  "fieldPath": "metadata.labels"
                }
              },
              {
                "path": "memory",
                "resourceFieldRef": {
                  "resource": "limits.memory"
                }
              }
            ]
          }
        },
        {
          "name": "csi",
          "csi": {
            "driver": "example.com/csi",
            "volumeAttributes": {
              "zone": "west",
              "tier": "fast"
            }
          }
        },
        {
          "name": "image",
          "image": {
            "reference": "example.invalid/image",
            "pullPolicy": "IfNotPresent"
          }
        },
        {
          "name": "iscsi",
          "iscsi": {
            "targetPortal": "example.invalid:3260",
            "iqn": "test",
            "lun": 1,
            "secretRef": {
              "name": "auth"
            }
          }
        },
        {
          "name": "fc",
          "fc": {
            "targetWWNs": ["one", "two"],
            "lun": 1,
            "fsType": "ext4"
          }
        },
        {
          "name": "flex",
          "flexVolume": {
            "driver": "example.com/driver",
            "options": {
              "mode": "test"
            }
          }
        }
      ]
    },
    "status": {
      "phase": "Pending"
    }
  },
  "events": []
}
